const int irSensorPin = 2;  // Connect OUT pin of IR sensor to digital pin 2

void setup() {
  pinMode(irSensorPin, INPUT);
  Serial.begin(9600);
}

void loop() {
  int sensorValue = digitalRead(irSensorPin);

  if (sensorValue == LOW) {
    Serial.println("Object detected!");
  } else {
    Serial.println("No object.");
  }

  delay(500);
}
