void setup() {
  // Start the serial communication at 9600 baud
  Serial.begin(9600);
  
  // Wait for Serial Monitor to open (optional but useful for some boards)
  while (!Serial) {
    ; // wait for serial port to connect. Needed for native USB
  }

  Serial.println("Serial Monitor Test Started!");
}

void loop() {
  // Print a message every second
  Serial.println("Hello from Arduino!");

  // Wait for 1 second
  delay(1000);
}
